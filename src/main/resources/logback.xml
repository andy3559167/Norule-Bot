<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- This warning includes YouTube's full format JSON; retain only actual errors from this client. -->
    <logger name="dev.lavalink.youtube.clients.skeleton.StreamingNonMusicClient" level="ERROR" />

    <!-- Configure root logger to output to console -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
