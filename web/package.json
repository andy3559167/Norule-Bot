{
  "name": "javabotopenai-web-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "dev:dashboard": "vite --config vite.dashboard.config.ts --host",
    "build": "npm run build:dashboard && npm run generate:short-url && npm run sync:short-url",
    "build:dashboard": "vite build --config vite.dashboard.config.ts",
    "generate:short-url": "nuxt generate",
    "sync:short-url": "node scripts/sync-static-output.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue-tsc": "3.2.5"
  }
}
